{
  "name": "linkinator-action",
  "version": "2.5.0",
  "description": "A GitHub Action that checks your README and other markdown for 404s.",
  "main": "dist/index.cjs",
  "scripts": {
    "test": "vitest run",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "build": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/index.cjs --sourcemap"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/linkinator-action.git"
  },
  "keywords": [
    "404",
    "link",
    "checker"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/linkinator-action/issues"
  },
  "homepage": "https://github.com/step-security/linkinator-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "linkinator": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "axios": "^1.8.4",
    "esbuild": "^0.28.1",
    "undici": "^8.10.0",
    "vitest": "^4.0.18"
  }
}
